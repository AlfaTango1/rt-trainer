{
  "name": "rt-trainer",
  "productName": "RT Trainer",
  "version": "1.0.0",
  "description": "ICAO radiotelephony trainer",
  "main": "main.js",
  "author": "Avazbek Tursunov",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "uz.rttrainer.desktop",
    "productName": "RT Trainer",
    "files": [
      "main.js",
      "icon.png",
      "app/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "RT Trainer",
      "artifactName": "RT-Trainer-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "public.app-category.education",
      "identity": null,
      "artifactName": "RT-Trainer-${version}-mac.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "icon.png",
      "category": "Education",
      "artifactName": "RT-Trainer-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "AlfaTango1",
      "repo": "rt-trainer"
    },
    "portable": {
      "artifactName": "RT-Trainer-Portable-${version}.${ext}"
    }
  },
  "repository": "https://github.com/AlfaTango1/rt-trainer"
}